# Every setting is optional — defaults run fully locally with no API key.
# Copy to .env and uncomment what you want to change.

# --- LLM provider -----------------------------------------------------------
# ollama (default, local) | anthropic | openai | gemini
# SECLIT_PROVIDER=ollama
# SECLIT_OLLAMA_MODEL=gemma3:12b
# SECLIT_OLLAMA_HOST=http://localhost:11434

# Hosted providers need their optional extra installed and a key set:
#   uv sync --extra anthropic  &&  export ANTHROPIC_API_KEY=...
# SECLIT_ANTHROPIC_MODEL=claude-sonnet-5
# SECLIT_OPENAI_MODEL=gpt-4o
# SECLIT_GEMINI_MODEL=gemini-2.0-flash

# --- Models -----------------------------------------------------------------
# SECLIT_EMBEDDING_MODEL=BAAI/bge-m3
# SECLIT_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# mps | cuda | cpu — autodetected when unset
# SECLIT_DEVICE=mps

# --- Retrieval --------------------------------------------------------------
# SECLIT_RETRIEVAL_MODE=hybrid_rerank  # dense | sparse | hybrid | hybrid_rerank
#                                     # "hybrid" gives up 0.010 MRR for ~137x lower latency
# SECLIT_FINAL_TOP_K=8            # excerpts passed to the model
# SECLIT_RERANK_CANDIDATES=24     # deeper pool = better ranking, slower
# SECLIT_RERANK_MAX_LENGTH=512    # 8192 is ~1.6x slower with no measured gain
# SECLIT_RERANK_SCORE_FLOOR=-6.0  # raise to refuse more marginal questions

# --- Chunking (changing these requires a re-index) ---------------------------
# SECLIT_CHUNK_TARGET_TOKENS=800
# SECLIT_CHUNK_OVERLAP_RATIO=0.15

# --- Corpus -----------------------------------------------------------------
# SECLIT_CORPUS_SIZE=100
# SECLIT_ARXIV_REQUEST_DELAY=3.0  # do not lower; arXiv will block the IP
# SECLIT_DATA_DIR=./data
